# Copy this file to .env for local development.
# Values are fictitious development placeholders. Do not commit real secrets.

NODE_ENV=development
APP_ORIGIN=http://localhost:5173

POSTGRES_DB=solverfin
POSTGRES_USER=solverfin
POSTGRES_PASSWORD=solverfin_dev_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://solverfin:solverfin_dev_password@localhost:5432/solverfin?schema=public

# Optional local session duration for the initial auth layer.
AUTH_SESSION_TTL_MINUTES=60

# Optional inactivity timeout for persisted application sessions.
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=30

# Demo auth is local-only by default. Keep false unless running an explicit non-production demo.
AUTH_ALLOW_DEMO=false

# Managed identity-provider page used by the "Esqueci minha senha" action.
AUTH_PASSWORD_RESET_URL=https://solverfin-auth.auth.sa-east-1.amazoncognito.com/forgotPassword

# Comma-separated list of emails allowed to access global Admin features.
# Leave empty in local environments that do not need Admin access; empty config fails closed.
SOLVERFIN_MASTER_EMAILS=master@solverfin.example.invalid

# Daily CDI import and account-remuneration processing.
# Disabled by default; enable only in one API scheduler instance per environment.
ACCOUNT_REMUNERATION_DAILY_ENABLED=false
# UTC hour from 0 to 23. 10 UTC corresponds to 07:00 in Sao Paulo during standard time.
ACCOUNT_REMUNERATION_DAILY_HOUR_UTC=10
# Optional override used by tests or controlled provider migrations.
BCB_SGS_CDI_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.12/dados

# Cloudflare R2 settings for Admin institution logo uploads. Keep real values only in protected environments.
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=dev-r2-access-key
R2_SECRET_ACCESS_KEY=dev-r2-secret-key
R2_BUCKET_NAME=solverfin-assets
R2_PUBLIC_BASE_URL=https://assets.example.invalid
R2_REGION=auto
INSTITUTION_LOGO_MAX_BYTES=2097152

# AI provider. Keep disabled for local/test unless a protected environment explicitly enables it.
AI_PROVIDER=disabled
# OpenAI-compatible Chat Completions endpoint. The adapter accepts HTTPS only.
AI_OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# Fictitious disabled placeholder. Configure a real credential only in a protected environment.
AI_OPENAI_API_KEY=solverfin-ai-disabled-placeholder
# Model remains environment-controlled so it can be replaced without changing domain code.
AI_OPENAI_MODEL=gpt-5-mini
AI_OPENAI_MAX_OUTPUT_TOKENS=1200
AI_OPENAI_MAX_REQUEST_BYTES=32768
AI_OPENAI_REQUEST_TIMEOUT_MS=8000
# Read-only financial assistant context retention. Integer from 5 to 1440 minutes.
FINANCIAL_ASSISTANT_TTL_MINUTES=120

# Productive authentication uses Amazon Cognito User Pools in sa-east-1.
# Keep these as fictitious development placeholders here; configure real values only in protected environments.
OIDC_ISSUER_URL=https://cognito-idp.sa-east-1.amazonaws.com/sa-east-1_example
OIDC_CLIENT_ID=solverfin-local-client
# Temporary compatibility alias for the ID-token audience; keep equal to OIDC_CLIENT_ID.
OIDC_AUDIENCE=solverfin-local-client
OIDC_AUTHORIZATION_URL=https://solverfin-auth.auth.sa-east-1.amazoncognito.com/oauth2/authorize
OIDC_TOKEN_URL=https://solverfin-auth.auth.sa-east-1.amazoncognito.com/oauth2/token
OIDC_JWKS_URI=https://cognito-idp.sa-east-1.amazonaws.com/sa-east-1_example/.well-known/jwks.json
OIDC_REDIRECT_URI=https://app.example.invalid/api/auth/oidc/callback
OIDC_LOGOUT_URL=https://solverfin-auth.auth.sa-east-1.amazoncognito.com/logout
OIDC_RECOVERY_URL=https://solverfin-auth.auth.sa-east-1.amazoncognito.com/forgotPassword
OIDC_ATTEMPT_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
OIDC_ATTEMPT_TTL_MINUTES=10
# Optional cleanup cadence. Values below 10000 ms fall back to 60000 ms.
OIDC_ATTEMPT_CLEANUP_INTERVAL_MS=60000
# Local/test-only escape hatch for non-browser adapters. Keep false in normal browser use.
AUTH_ALLOW_MISSING_ORIGIN=false
