generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FinancialContextKind {
  PERSONAL
  FAMILY
  MEI
  BUSINESS
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum CardStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum CardInstrumentType {
  PHYSICAL
  VIRTUAL
}

enum CardInstrumentHolder {
  PRIMARY
  ADDITIONAL
}

enum CardInstrumentStatus {
  ACTIVE
  ARCHIVED
}

enum AccountKind {
  CHECKING
  SAVINGS
  CASH
  INVESTMENT
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionKind {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PLANNED
  POSTED
  RECONCILED
  SUGGESTED
  VOIDED
}

enum TransactionSource {
  MANUAL
  RECURRENCE
  INSTALLMENT
  IMPORT
  AI_SUGGESTION
  ACCOUNT_REMUNERATION
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum InstallmentStatus {
  PLANNED
  POSTED
  RECONCILED
  CANCELLED
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
  CANCELLED
}

enum PayableReceivableKind {
  PAYABLE
  RECEIVABLE
}

enum PayableReceivableStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum ImportSourceKind {
  CSV
  OFX
  XLSX
  PDF
  BANK_MESSAGE
  MANUAL
}

enum ImportStatus {
  RECEIVED
  PARSED
  REVIEWING
  COMPLETED
  FAILED
  DISCARDED
}

enum AiSuggestionKind {
  TRANSACTION_EXTRACTION
  CATEGORIZATION
  DEDUPLICATION
  RECONCILIATION
  INSIGHT
}

enum AiSuggestionStatus {
  PENDING_REVIEW
  APPROVED
  EDITED
  REJECTED
  EXPIRED
  RESOLVED
}

enum AttachmentKind {
  RECEIPT
  INVOICE
  STATEMENT
  MESSAGE
  CONTRACT
  OTHER
}

enum AttachmentStatus {
  ACTIVE
  REDACTED
  DELETED
}

enum AuditActorKind {
  USER
  SYSTEM
  AI
  IMPORT
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  SOFT_DELETE
  RECONCILE
  UNRECONCILE
  APPROVE
  REJECT
}

enum AuditEntityKind {
  ACCOUNT
  CARD
  CARD_INSTRUMENT
  CATEGORY
  TRANSACTION
  RECURRENCE
  INSTALLMENT
  INVOICE
  BUDGET
  IMPORT_BATCH
  PRIVACY_CONSENT
  PAYABLE_RECEIVABLE
  AI_SUGGESTION
  ATTACHMENT
  FINANCIAL_NOTIFICATION
}

enum LinkedEntityKind {
  TRANSACTION
  INVOICE
  IMPORT_BATCH
  AI_SUGGESTION
}

enum OidcLoginAttemptStatus {
  PENDING
  PROCESSING
  CONSUMED
  CANCELLED
  EXPIRED
  FAILED
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  email                String     @unique @db.VarChar(320)
  displayName          String     @db.VarChar(160)
  passwordHash         String?    @db.VarChar(128)
  externalAuthProvider String?    @db.VarChar(200)
  externalAuthSubject  String?    @db.VarChar(240)
  status               UserStatus @default(ACTIVE)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  ownedOrganizations  Organization[]       @relation("OrganizationOwner")
  ownedProfiles       FinancialProfile[]   @relation("FinancialProfileOwner")
  applicationSessions ApplicationSession[]
  securityAuditEvents SecurityAuditEvent[]
  financialNotifications FinancialNotification[] @relation("FinancialNotificationRecipient")
  financialNotificationPreferences FinancialNotificationPreference[] @relation("FinancialNotificationPreferenceRecipient")
  whatsappChannelLinks WhatsappChannelLink[]
  whatsappChannelEvents WhatsappChannelEvent[]

  @@unique([externalAuthProvider, externalAuthSubject])
  @@index([status])
}

model ApplicationSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  tokenHash        String    @unique @db.VarChar(128)
  transport        String    @default("cookie") @db.VarChar(24)
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?   @db.VarChar(120)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  auditEvents SecurityAuditEvent[]

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastSeenAt])
  @@index([transport, revokedAt])
}

model SecurityAuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  sessionId     String?  @db.Uuid
  occurredAt    DateTime @default(now())
  action        String   @db.VarChar(80)
  result        String   @db.VarChar(40)
  correlationId String?  @db.VarChar(120)
  metadata      Json?

  user    User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  session ApplicationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([action, occurredAt])
  @@index([correlationId])
}

model OidcLoginAttempt {
  id                    String                 @id @default(uuid()) @db.Uuid
  stateHash             String                 @unique @db.VarChar(64)
  nonceHash             String                 @db.VarChar(64)
  encryptedCodeVerifier String                 @db.Text
  issuer                String                 @db.VarChar(500)
  returnTo              String                 @db.VarChar(2048)
  status                OidcLoginAttemptStatus @default(PENDING)
  version               Int                    @default(0)
  createdAt             DateTime               @default(now())
  expiresAt             DateTime
  consumedAt            DateTime?
  terminalReason        String?                @db.VarChar(120)

  @@index([status, expiresAt])
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @db.Uuid
  name        String   @db.VarChar(160)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User               @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  profiles FinancialProfile[]

  @@index([ownerUserId])
}

model FinancialProfile {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  ownerUserId    String               @db.Uuid
  name           String               @db.VarChar(160)
  kind           FinancialContextKind
  status         RecordStatus         @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner                       User                         @relation("FinancialProfileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  accounts                    Account[]
  cards                       Card[]
  cardInstruments             CardInstrument[]
  categories                  Category[]
  transactions                Transaction[]
  recurrences                 Recurrence[]
  installments                Installment[]
  invoices                    Invoice[]
  budgets                     Budget[]
  payablesReceivables         PayableReceivable[]
  importBatches               ImportBatch[]
  aiSuggestions               AiSuggestion[]
  attachments                 Attachment[]
  auditLogs                   AuditLogEntry[]
  financialNotifications      FinancialNotification[]
  financialNotificationPreferences FinancialNotificationPreference[]
  whatsappChannelLinks WhatsappChannelLink[]
  whatsappChannelEvents WhatsappChannelEvent[]
  transactionGroups           TransactionGroup[]
  installmentCreationRequests InstallmentCreationRequest[]
  transactionCreationRequests TransactionCreationRequest[]

  @@unique([id, organizationId])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, status])
}

model Account {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @db.Uuid
  financialProfileId  String       @db.Uuid
  name                String       @db.VarChar(160)
  kind                AccountKind
  status              RecordStatus @default(ACTIVE)
  currency            String       @default("BRL") @db.Char(3)
  openingBalanceMinor BigInt       @default(0) @db.BigInt
  agencyIdentifier    String?      @db.VarChar(80)
  accountIdentifier   String?      @db.VarChar(80)
  maskedIdentifier    String?      @db.VarChar(80)
  institutionKey      String?      @db.VarChar(80)
  createdByUserId     String?      @db.Uuid
  updatedByUserId     String?      @db.Uuid
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  financialProfile    FinancialProfile    @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  transactions        Transaction[]       @relation("TransactionAccount")
  incomingTransfers   Transaction[]       @relation("TransactionDestinationAccount")
  paymentCards        Card[]              @relation("CardPaymentAccount")
  recurrences         Recurrence[]        @relation("RecurrenceAccount")
  incomingRecurrences Recurrence[]        @relation("RecurrenceDestinationAccount")
  payablesReceivables PayableReceivable[]
  importBatches       ImportBatch[]       @relation("ImportBatchDefaultAccount")
  transactionGroups   TransactionGroup[]

  @@unique([id, organizationId, financialProfileId])
  @@index([organizationId, financialProfileId, status])
  @@index([organizationId, financialProfileId, kind])
  @@index([organizationId, financialProfileId, institutionKey])
}

model Card {
  id                 String     @id @default(uuid()) @db.Uuid
  organizationId     String     @db.Uuid
  financialProfileId String     @db.Uuid
  paymentAccountId   String?    @db.Uuid
  name               String     @db.VarChar(160)
  status             CardStatus @default(ACTIVE)
  closingDay         Int
  dueDay             Int
  creditLimitMinor   BigInt?    @db.BigInt
  currency           String?    @db.Char(3)
  maskedIdentifier   String?    @db.VarChar(80)
  institutionKey     String?    @db.VarChar(80)
  brandKey           String?    @db.VarChar(80)
  createdByUserId    String?    @db.Uuid
  updatedByUserId    String?    @db.Uuid
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  financialProfile FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  paymentAccount   Account?         @relation("CardPaymentAccount", fields: [paymentAccountId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  instruments      CardInstrument[]
  transactions     Transaction[]    @relation("TransactionCard")
  invoices         Invoice[]
  installments     Installment[]
  recurrences      Recurrence[]
  importBatches     ImportBatch[]       @relation("ImportBatchDefaultCard")

  @@unique([id, organizationId, financialProfileId])
  @@index([organizationId, financialProfileId, status])
  @@index([organizationId, financialProfileId, institutionKey])
  @@index([organizationId, financialProfileId, brandKey])
}

model CardInstrument {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @db.Uuid
  financialProfileId String               @db.Uuid
  cardId             String               @db.Uuid
  type               CardInstrumentType
  holder             CardInstrumentHolder
  status             CardInstrumentStatus @default(ACTIVE)
  isDefault          Boolean              @default(false)
  name               String?              @db.VarChar(160)
  maskedIdentifier   String?              @db.VarChar(80)
  creditLimitMinor   BigInt?               @db.BigInt
  createdByUserId    String?              @db.Uuid
  updatedByUserId    String?              @db.Uuid
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  financialProfile FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  card             Card             @relation(fields: [cardId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Cascade)
  transactions     Transaction[]
  recurrences      Recurrence[]
  installments     Installment[]

  @@unique([id, organizationId, financialProfileId])
  @@index([organizationId, financialProfileId, cardId, status])
  @@index([organizationId, financialProfileId, cardId, isDefault])
}

model Category {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  financialProfileId String       @db.Uuid
  parentCategoryId   String?      @db.Uuid
  name               String       @db.VarChar(160)
  kind               CategoryKind
  status             RecordStatus @default(ACTIVE)
  createdByUserId    String?      @db.Uuid
  updatedByUserId    String?      @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  financialProfile    FinancialProfile    @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parentCategory      Category?           @relation("CategoryTree", fields: [parentCategoryId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  childCategories     Category[]          @relation("CategoryTree")
  transactions        Transaction[]
  recurrences         Recurrence[]
  budgets             Budget[]
  payablesReceivables PayableReceivable[]

  @@unique([id, organizationId, financialProfileId])
  @@index([organizationId, financialProfileId, kind, status])
  @@index([organizationId, financialProfileId, parentCategoryId])
}

model Transaction {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @db.Uuid
  financialProfileId   String            @db.Uuid
  accountId            String?           @db.Uuid
  destinationAccountId String?           @db.Uuid
  categoryId           String?           @db.Uuid
  cardId               String?           @db.Uuid
  cardInstrumentId     String?           @db.Uuid
  invoiceId            String?           @db.Uuid
  recurrenceId         String?           @db.Uuid
  installmentId        String?           @db.Uuid
  importBatchId        String?           @db.Uuid
  aiSuggestionId       String?           @db.Uuid
  transferGroupId      String?           @db.Uuid
  transactionGroupId   String?           @db.Uuid
  kind                 TransactionKind
  status               TransactionStatus @default(PLANNED)
  source               TransactionSource @default(MANUAL)
  amountMinor          BigInt             @db.BigInt
  currency             String            @default("BRL") @db.Char(3)
  destinationAmountMinor BigInt?           @db.BigInt
  destinationCurrency  String?            @db.Char(3)
  occurredOn           DateTime          @db.Date
  plannedOn            DateTime          @db.Date
  effectiveOn          DateTime?         @db.Date
  description          String            @db.VarChar(240)
  note                 String?           @db.Text
  reconciledAt         DateTime?
  voidedAt             DateTime?
  createdByUserId      String?           @db.Uuid
  updatedByUserId      String?           @db.Uuid
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  financialProfile         FinancialProfile   @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  account                  Account?           @relation("TransactionAccount", fields: [accountId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  destinationAccount       Account?           @relation("TransactionDestinationAccount", fields: [destinationAccountId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  category                 Category?          @relation(fields: [categoryId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  card                     Card?              @relation("TransactionCard", fields: [cardId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  cardInstrument           CardInstrument?    @relation(fields: [cardInstrumentId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  invoice                  Invoice?           @relation("InvoiceTransactions", fields: [invoiceId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  recurrence               Recurrence?        @relation(fields: [recurrenceId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  installment              Installment?       @relation("TransactionInstallment", fields: [installmentId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  purchaseInstallments     Installment[]      @relation("InstallmentPurchaseTransaction")
  importBatch              ImportBatch?       @relation(fields: [importBatchId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  aiSuggestion             AiSuggestion?      @relation(fields: [aiSuggestionId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  paidInvoice              Invoice?           @relation("InvoicePaymentTransaction")
  settledPayableReceivable PayableReceivable? @relation("PayableReceivableSettlementTransaction")
  transactionGroup         TransactionGroup?  @relation(fields: [transactionGroupId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)

  @@unique([id, organizationId, financialProfileId])
  @@unique([organizationId, financialProfileId, aiSuggestionId])
  @@index([organizationId, financialProfileId, occurredOn])
  @@index([organizationId, financialProfileId, status, occurredOn])
  @@index([organizationId, financialProfileId, accountId, occurredOn])
  @@index([organizationId, financialProfileId, plannedOn])
  @@index([organizationId, financialProfileId, status, plannedOn])
  @@index([organizationId, financialProfileId, accountId, plannedOn])
  @@index([organizationId, financialProfileId, effectiveOn])
  @@index([organizationId, financialProfileId, cardId, occurredOn])
  @@index([organizationId, financialProfileId, cardInstrumentId, occurredOn])
  @@index([organizationId, financialProfileId, categoryId, occurredOn])
  @@index([organizationId, financialProfileId, importBatchId])
  @@index([organizationId, financialProfileId, transferGroupId])
  @@index([organizationId, financialProfileId, transactionGroupId])
}

model TransactionGroup {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  financialProfileId String   @db.Uuid
  accountId          String   @db.Uuid
  description        String   @db.VarChar(240)
  displayOn          DateTime @db.Date
  createdByUserId    String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  financialProfile FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  account          Account          @relation(fields: [accountId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  members          Transaction[]

  @@unique([id, organizationId, financialProfileId])
  @@index([organizationId, financialProfileId, accountId, displayOn])
}

model Recurrence {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  financialProfileId String              @db.Uuid
  accountId          String?             @db.Uuid
  destinationAccountId String?           @db.Uuid
  cardId             String?             @db.Uuid
  cardInstrumentId   String?             @db.Uuid
  categoryId         String?             @db.Uuid
  status             RecurrenceStatus    @default(ACTIVE)
  kind               TransactionKind     @default(EXPENSE)
  frequency          RecurrenceFrequency
  interval           Int                 @default(1)
  startOn            DateTime            @db.Date
  endOn              DateTime?           @db.Date
  amountMinor        BigInt               @db.BigInt
  currency           String              @default("BRL") @db.Char(3)
  description        String              @db.VarChar(240)
  createdByUserId    String?             @db.Uuid
  updatedByUserId    String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  financialProfile FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  account          Account?         @relation("RecurrenceAccount", fields: [accountId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  destinationAccount Account?       @relation("RecurrenceDestinationAccount", fields: [destinationAccountId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  card             Card?            @relation(fields: [cardId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  cardInstrument   CardInstrument?  @relation(fields: [cardInstrumentId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  category         Category?        @relation(fields: [categoryId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  transactions     Transaction[]
  installments     Installment[]

  @@unique([id, organizationId, financialProfileId])
  @@index([organizationId, financialProfileId, status])
  @@index([organizationId, financialProfileId, startOn])
  @@index([organizationId, financialProfileId, cardId])
  @@index([organizationId, financialProfileId, cardInstrumentId])
  @@index([organizationId, financialProfileId, destinationAccountId])
}

model Installment {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  financialProfileId String            @db.Uuid
  recurrenceId       String?           @db.Uuid
  transactionId      String?           @db.Uuid
  invoiceId          String?           @db.Uuid
  cardId             String?           @db.Uuid
  cardInstrumentId   String?           @db.Uuid
  status             InstallmentStatus @default(PLANNED)
  sequenceNumber     Int
  totalInstallments  Int
  dueOn              DateTime          @db.Date
  amountMinor        BigInt             @db.BigInt
  currency           String            @default("BRL") @db.Char(3)
  createdByUserId    String?           @db.Uuid
  updatedByUserId    String?           @db.Uuid
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  financialProfile  FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recurrence        Recurrence?      @relation(fields: [recurrenceId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  sourceTransaction Transaction?     @relation("InstallmentPurchaseTransaction", fields: [transactionId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  invoice           Invoice?         @relation("InvoiceInstallments", fields: [invoiceId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  card              Card?            @relation(fields: [cardId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  cardInstrument    CardInstrument?  @relation(fields: [cardInstrumentId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  transactions      Transaction[]    @relation("TransactionInstallment")

  @@unique([id, organizationId, financialProfileId])
  @@unique([organizationId, financialProfileId, recurrenceId, sequenceNumber])
  @@unique([organizationId, financialProfileId, transactionId, sequenceNumber])
  @@index([organizationId, financialProfileId, dueOn])
  @@index([organizationId, financialProfileId, status])
  @@index([organizationId, financialProfileId, cardInstrumentId])
  @@index([organizationId, financialProfileId, invoiceId])
}

model InstallmentCreationRequest {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  financialProfileId String   @db.Uuid
  idempotencyKey     String   @db.Uuid
  requestFingerprint String   @db.Char(64)
  response           Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  financialProfile FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, financialProfileId, idempotencyKey])
  @@index([organizationId, financialProfileId, createdAt])
}

model TransactionCreationRequest {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  financialProfileId String   @db.Uuid
  idempotencyKey     String   @db.Uuid
  requestFingerprint String   @db.Char(64)
  response           Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  financialProfile FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, financialProfileId, idempotencyKey])
  @@index([organizationId, financialProfileId, createdAt])
}

model Invoice {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String        @db.Uuid
  financialProfileId   String        @db.Uuid
  cardId               String        @db.Uuid
  paymentTransactionId String?       @unique @db.Uuid
  status               InvoiceStatus @default(OPEN)
  periodStartOn        DateTime      @db.Date
  periodEndOn          DateTime      @db.Date
  dueOn                DateTime      @db.Date
  totalAmountMinor     BigInt         @default(0) @db.BigInt
  currency             String        @default("BRL") @db.Char(3)
  paidAt               DateTime?
  createdByUserId      String?       @db.Uuid
  updatedByUserId      String?       @db.Uuid
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  financialProfile   FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  card               Card             @relation(fields: [cardId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  transactions       Transaction[]    @relation("InvoiceTransactions")
  installments       Installment[]    @relation("InvoiceInstallments")
  paymentTransaction Transaction?     @relation("InvoicePaymentTransaction", fields: [paymentTransactionId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)

  @@unique([id, organizationId, financialProfileId])
  @@unique([paymentTransactionId, organizationId, financialProfileId])
  @@index([organizationId, financialProfileId, cardId, dueOn])
  @@index([organizationId, financialProfileId, status])
}

model Budget {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @db.Uuid
  financialProfileId    String       @db.Uuid
  categoryId            String       @db.Uuid
  status                RecordStatus @default(ACTIVE)
  periodStartOn         DateTime     @db.Date
  periodEndOn           DateTime     @db.Date
  plannedAmountMinor    BigInt        @db.BigInt
  currency              String       @default("BRL") @db.Char(3)
  alertThresholdPercent Int?
  createdByUserId       String?      @db.Uuid
  updatedByUserId       String?      @db.Uuid
  createdAt              DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  financialProfile FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  category         Category         @relation(fields: [categoryId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)

  @@unique([id, organizationId, financialProfileId])
  @@unique([organizationId, financialProfileId, categoryId, periodStartOn, periodEndOn])
  @@index([organizationId, financialProfileId, periodStartOn, periodEndOn])
}

model PayableReceivable {
  id                      String                  @id @default(uuid()) @db.Uuid
  organizationId          String                  @db.Uuid
  financialProfileId      String                  @db.Uuid
  accountId               String?                 @db.Uuid
  categoryId              String?                 @db.Uuid
  settlementTransactionId String?                 @unique @db.Uuid
  kind                    PayableReceivableKind
  status                  PayableReceivableStatus @default(PENDING)
  amountMinor             BigInt                  @db.BigInt
  currency                String                  @default("BRL") @db.Char(3)
  dueOn                   DateTime                @db.Date
  description             String                  @db.VarChar(240)
  settledAt               DateTime?
  cancelledAt             DateTime?
  createdByUserId         String?                 @db.Uuid
  updatedByUserId         String?                 @db.Uuid
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  financialProfile      FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  account               Account?         @relation(fields: [accountId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  category              Category?        @relation(fields: [categoryId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  settlementTransaction Transaction?     @relation("PayableReceivableSettlementTransaction", fields: [settlementTransactionId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)

  @@unique([id, organizationId, financialProfileId])
  @@unique([settlementTransactionId, organizationId, financialProfileId])
  @@index([organizationId, financialProfileId, kind, status, dueOn])
  @@index([organizationId, financialProfileId, accountId, dueOn])
  @@index([organizationId, financialProfileId, categoryId, dueOn])
}

model ImportBatch {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  financialProfileId String           @db.Uuid
  defaultAccountId   String?          @db.Uuid
  sourceKind         ImportSourceKind
  status             ImportStatus     @default(RECEIVED)
  originalFileName   String?          @db.VarChar(240)
  sourceHash         String           @db.VarChar(128)
  contentHash        String?          @db.VarChar(80)
  totalRows          Int              @default(0)
  validRows          Int              @default(0)
  duplicateRows      Int              @default(0)
  problemRows        Int              @default(0)
  problems           Json             @default("[]")
  csvDelimiter       String?          @db.VarChar(1)
  csvMapping         Json?
  defaultCardId      String?          @db.Uuid
  documentClass      String?          @db.VarChar(40)
  parserId           String?          @db.VarChar(120)
  parserVersion      String?          @db.VarChar(40)
  xlsxSheetName      String?          @db.VarChar(120)
  xlsxMapping        Json?
  receivedAt         DateTime         @default(now())
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  financialProfile FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  defaultAccount   Account?         @relation("ImportBatchDefaultAccount", fields: [defaultAccountId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  defaultCard      Card?            @relation("ImportBatchDefaultCard", fields: [defaultCardId, organizationId, financialProfileId], references: [id, organizationId, financialProfileId], onDelete: Restrict)
  transactions     Transaction[]

  @@unique([id, organizationId, financialProfileId])
  @@unique([organizationId, financialProfileId, sourceHash])
  @@index([organizationId, financialProfileId, sourceKind, status])
  @@index([organizationId, financialProfileId, defaultAccountId])
  @@index([organizationId, financialProfileId, defaultCardId])
  @@index([organizationId, financialProfileId, contentHash])
  @@index([organizationId, financialProfileId, receivedAt])
}

model AiSuggestion {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  financialProfileId String             @db.Uuid
  kind               AiSuggestionKind
  status             AiSuggestionStatus @default(PENDING_REVIEW)
  sourceEntityId     String?            @db.Uuid
  targetEntityId     String?            @db.Uuid
  confidence         Decimal            @db.Decimal(5, 4)
  explanation        String             @db.VarChar(500)
  payload            Json?
  sourceSuggestionId String?            @db.Uuid
  payloadFingerprint String?            @db.VarChar(128)
  provider           String?            @db.VarChar(80)
  model              String?            @db.VarChar(120)
  reviewedByUserId   String?            @db.Uuid
  reviewedAt         DateTime?
  snoozedUntil       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  financialProfile FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  transactions     Transaction[]

  @@unique([id, organizationId, financialProfileId])
  @@unique([organizationId, financialProfileId, kind, sourceSuggestionId, payloadFingerprint, targetEntityId])
  @@index([organizationId, financialProfileId, status, kind])
  @@index([organizationId, financialProfileId, sourceSuggestionId])
  @@index([organizationId, financialProfileId, sourceEntityId])
  @@index([organizationId, financialProfileId, targetEntityId])
}

model Attachment {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  financialProfileId String           @db.Uuid
  kind               AttachmentKind
  status             AttachmentStatus @default(ACTIVE)
  fileName           String           @db.VarChar(240)
  mimeType           String           @db.VarChar(120)
  byteSize           Int?
  contentSha256      String?          @db.VarChar(64)
  storageKey         String           @db.VarChar(500)
  linkedEntityId     String           @db.Uuid
  linkedEntityKind   LinkedEntityKind
  redactedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  financialProfile FinancialProfile @relation(fields: [financialProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId, financialProfileId])
  @@index([organizationId, financialProfileId, linkedEntityKind, linkedEntityId])
  @@index([organizationId, financialProfileId, status])
}

model AttachmentObject {
  storageKey    String   @id @db.VarChar(500)
  content       Bytes
  byteSize      Int
  contentSha256 String   @db.VarChar(64)
  createdAt     DateTime @default(now())
